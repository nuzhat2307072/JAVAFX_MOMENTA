<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane styleClass="auth-root" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.momenta.controller.RegisterController">

    <VBox styleClass="auth-card" maxWidth="400" maxHeight="560" alignment="CENTER" spacing="12">
        <Label styleClass="auth-brand" text="Create Account" />
        <Label styleClass="auth-tagline" text="Join MOMENTA to organize your work" />

        <VBox spacing="4" style="-fx-padding: 12 0 0 0;">
            <Label styleClass="field-label" text="Username" />
            <TextField fx:id="usernameField" promptText="Choose a username" />
        </VBox>

        <VBox spacing="4">
            <Label styleClass="field-label" text="Occupation" />
            <ComboBox fx:id="occupationBox" maxWidth="Infinity" promptText="Select your occupation" />
        </VBox>

        <VBox spacing="4">
            <Label styleClass="field-label" text="Password" />
            <PasswordField fx:id="passwordField" promptText="Choose a password" />
        </VBox>

        <VBox spacing="4">
            <Label styleClass="field-label" text="Confirm Password" />
            <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password" />
        </VBox>

        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" />

        <Button styleClass="primary-button" text="Create Account" maxWidth="Infinity" onAction="#handleRegister" />

        <HBox alignment="CENTER" spacing="4">
            <Label text="Already have an account?" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" />
            <Label styleClass="link-text" text="Log in" onMouseClicked="#goToLogin" />
        </HBox>
    </VBox>
</StackPane>
