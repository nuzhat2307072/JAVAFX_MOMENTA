<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane styleClass="auth-root" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.momenta.controller.LoginController">

    <VBox styleClass="auth-card" maxWidth="380" maxHeight="440" alignment="CENTER" spacing="14">
        <Label styleClass="auth-brand" text="MOMENTA" />
        <Label styleClass="auth-tagline" text="Personal Work &amp; Productivity Operating System" />

        <VBox spacing="4" style="-fx-padding: 16 0 0 0;">
            <Label styleClass="field-label" text="Username" />
            <TextField fx:id="usernameField" promptText="Enter your username" />
        </VBox>

        <VBox spacing="4">
            <Label styleClass="field-label" text="Password" />
            <PasswordField fx:id="passwordField" promptText="Enter your password" />
        </VBox>

        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" />

        <Button styleClass="primary-button" text="Login" maxWidth="Infinity" onAction="#handleLogin" />

        <HBox alignment="CENTER" spacing="4">
            <Label text="Don't have an account?" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" />
            <Label styleClass="link-text" text="Create one" onMouseClicked="#goToRegister" />
        </HBox>
    </VBox>
</StackPane>
